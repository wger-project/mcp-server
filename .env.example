# ============================================================================
# wger-mcp configuration  (wger >= 2.6, multi-user via OIDC SSO)
# ============================================================================
# Every request acts as the calling user's own wger account. The client presents
# an OIDC token; this server exchanges it (RFC 8693) for a wger JWT and calls
# the wger REST API as that user. See docs/adr/0001-*.md.

# --- Upstream wger ----------------------------------------------------------
WGER_BASE_URL=https://wger.example.com

# --- Inbound auth strategy --------------------------------------------------
# One of: oidc | static_token | none
#   oidc         multi-user SSO; every request acts as the calling user.
#   static_token single-user; callers present a shared secret. No IdP needed.
#   none         single-user, NO inbound auth. Localhost only.
MCP_AUTH=oidc

# ---- Strategy: oidc (default) ------------------------------------------
# OIDC issuer (the same IdP/realm wger uses for OIDC social login).
OIDC_ISSUER=https://auth.example.com/realms/main
# Derived from the issuer when omitted:
#OIDC_JWKS_URI=https://auth.example.com/realms/main/protocol/openid-connect/certs
#OIDC_TOKEN_ENDPOINT=https://auth.example.com/realms/main/protocol/openid-connect/token
# Used by the AS facade (/authorize -> here). Derived from the issuer too.
#OIDC_AUTHORIZATION_ENDPOINT=https://auth.example.com/realms/main/protocol/openid-connect/auth

# Inbound-token validation.
# If set, the inbound token's 'aud' (or 'azp') must match this.
#MCP_OIDC_AUDIENCE=wger-mcp
#MCP_OIDC_ALGORITHMS=RS256
# Which claim names the user (preferred_username | email | sub).
MCP_OIDC_USERNAME_CLAIM=preferred_username
# Optional allowlist (comma-separated). Empty = any authenticated SSO user.
#MCP_OIDC_ALLOWED_USERS=
#MCP_JWKS_TTL_SECONDS=3600

# ---- Token exchange (this server as a confidential OIDC client) --------
# A confidential OIDC client with token-exchange (RFC 8693) permission to
# the wger client's audience.
OIDC_CLIENT_ID=wger-mcp
OIDC_CLIENT_SECRET=CHANGE_ME
# The audience to exchange to = wger's OIDC client id at the IdP.
WGER_OIDC_AUDIENCE=wger
# allauth provider id of the OIDC connection in wger (SocialApp.provider_id).
# Often "openid_connect", but may be a custom slug set in wger admin — match it.
WGER_ALLAUTH_PROVIDER=openid_connect

# ---- Strategy: static_token (single-user, no IdP) --------------------------
# Callers must present MCP_STATIC_TOKEN as a bearer token; the server then calls
# wger with your personal DRF API key (Settings -> API -> "API key"). Inbound
# requests ARE authenticated, so this is safe to expose over TLS — but the
# secret grants full access to that wger account, so treat it like a password.
# Generate one with:  openssl rand -hex 32      (min 32 characters)
#MCP_AUTH=static_token
#MCP_STATIC_TOKEN=
#WGER_DEV_TOKEN=

# ---- Strategy: none (LOCAL DEV ONLY) ---------------------------------------
# NO inbound authentication: anyone who can reach /mcp acts as the account
# behind WGER_DEV_TOKEN. Bind to localhost; never expose it to a network, even
# behind TLS. Prefer static_token above if you need to reach it remotely.
#MCP_AUTH=none
#WGER_DEV_TOKEN=

# --- Tool surface -----------------------------------------------------------
# Which tool groups to register, comma-separated. Empty = all of them.
# Valid groups: profile, routines, workout_logs, body_weight, measurements,
# equipment, nutrition, exercises, analytics, off.
# The full surface is 81 tools. Small local models lose accuracy as the tool
# count grows, and a single-purpose agent rarely needs every group, so trim it
# to what the agent actually uses. An unknown name fails at startup.
# Example, a food-logging agent:
#MCP_TOOLS=nutrition,off,profile

# --- Localisation -----------------------------------------------------------
# Default ISO 639-1 language for content lookups: the default for the exercise-
# and ingredient-search tools' `language` argument, and which localised Open
# Food Facts fields (product_name_<lang>, ingredients_text_<lang>) are requested
# and preferred. Per-call `language` arguments always override this.
#DEFAULT_LANGUAGE=en

# --- Transport --------------------------------------------------------------
HOST=0.0.0.0
PORT=8765
# MCP endpoint mount path. Final URL: http(s)://host:port/mcp
MCP_PATH=/mcp
# Externally reachable base URL. Used as the OAuth protected-resource identifier
# AND as the issuer/endpoints in the AS-facade metadata (/.well-known/
# oauth-authorization-server). REQUIRED when fronting a client like claude.ai
# that treats this origin as the authorization server. Falls back to the
# request's X-Forwarded-*/Host, then host:port.
#MCP_PUBLIC_URL=https://wger-mcp.example.com

# AS-facade endpoint paths. This origin acts as the OAuth authorization server;
# clients like claude.ai assume these conventional root paths and IGNORE the
# authorization_endpoint advertised in the AS metadata. Defaults below match that.
# Override (e.g. /oauth/authorize) only if your client expects a different path —
# no rebuild needed, these are read from the environment.
#OAUTH_AUTHORIZE_PATH=/authorize
#OAUTH_TOKEN_PATH=/token

# DNS rebinding protection. Comma-separated Host header values you accept.
# Empty = disabled (e.g. local dev). Production: set to your public hostname.
ALLOWED_HOSTS=
