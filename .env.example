# ============================================================================
# wger-mcp configuration  (wger >= 2.6, multi-user)
# ============================================================================
# Every request acts as the calling user's own wger account. Where that user's
# wger credential comes from is what MCP_AUTH picks:
#
#   wger >= 2.7  wger is itself the OAuth2/OIDC provider and its API accepts
#                the tokens it issues, so the caller's token is passed straight
#                through. Two lines of configuration. See docs/adr/0005-*.md.
#   wger 2.6     an external OIDC IdP issues the token and this server exchanges
#                it (RFC 8693) for a wger JWT. See docs/adr/0001-*.md.

# --- Upstream wger ----------------------------------------------------------
WGER_BASE_URL=https://wger.example.com

# --- Transport: stdio or http -----------------------------------------------
# NOT set here. The transport decides whether this file is read at all, so it
# cannot come from it: pass --transport, or set MCP_TRANSPORT in the environment.
# Writing MCP_TRANSPORT=stdio below is refused at startup rather than ignored.
#
# http (default)  listen on HOST:PORT below, with the inbound auth strategy.
# stdio           the MCP client spawns the server and talks over a pipe. That
#                 mode ignores this file entirely (the working directory is the
#                 client's, not yours) — configure it in the client's own JSON,
#                 see the README. Nothing here applies to it except
#                 WGER_BASE_URL, WGER_API_KEY, MCP_TOOLS and DEFAULT_LANGUAGE.

# --- Inbound auth strategy --------------------------------------------------
# One of: wger_oidc | oidc | static_token | none
#   wger_oidc    multi-user; wger itself is the provider. Needs wger >= 2.7 and
#                nothing but WGER_BASE_URL. RECOMMENDED where available.
#   oidc         multi-user; an external OIDC IdP, token exchanged for a wger
#                JWT. For wger 2.6, or where an SSO already fronts everything.
#   static_token single-user; callers present a shared secret. No IdP needed.
#   none         single-user, NO inbound auth. Localhost only.
# Default is oidc, so that upgrading this server never changes how an existing
# deployment authenticates. New wger >= 2.7 deployments: set wger_oidc.
MCP_AUTH=oidc

# ---- Strategy: wger_oidc (wger >= 2.7, recommended) ------------------------
# Nothing else is required: no client id, no secret, no issuer. wger's OAuth
# endpoints are read from {WGER_BASE_URL}/.well-known/openid-configuration.
# At wger, the provider must be switched on (IDP_OIDC_PRIVATE_KEY) and — unless
# dynamic client registration is enabled there — an OAuth client row must exist
# for each MCP client. See wger's docs/administration/oauth2_provider.rst.
#MCP_AUTH=wger_oidc
#
# What to ask wger for. openid identifies the user; api:read gates every read
# and api:write every write. Drop api:write for a read-only deployment (and
# pair that with a read-only MCP_TOOLS below).
#MCP_WGER_SCOPES=openid api:read api:write
#
# Optional allowlist, shared with the oidc strategy below. Costs one
# /api/v2/userprofile/ request per token (cached in memory) because an opaque
# token carries no username. Empty = any wger user who authorizes the client.
#MCP_OIDC_ALLOWED_USERS=
#
# If this server reaches wger over an INTERNAL url, set wger's PUBLIC authorize
# endpoint here: /authorize is followed by the user's browser, and discovery
# against an internal hostname hands back internal urls.
#OIDC_AUTHORIZATION_ENDPOINT=https://wger.example.com/identity/o/authorize

# ---- Strategy: oidc (default, external IdP / wger 2.6) ---------------------
# OIDC issuer (the same IdP/realm wger uses for OIDC social login).
OIDC_ISSUER=https://auth.example.com/realms/main
# Derived from the issuer when omitted:
#OIDC_JWKS_URI=https://auth.example.com/realms/main/protocol/openid-connect/certs
#OIDC_TOKEN_ENDPOINT=https://auth.example.com/realms/main/protocol/openid-connect/token
# Used by the AS facade (/authorize -> here). Derived from the issuer too.
#OIDC_AUTHORIZATION_ENDPOINT=https://auth.example.com/realms/main/protocol/openid-connect/auth

# Inbound-token validation.
# If set, the inbound token's 'aud' (or 'azp') must match this.
#MCP_OIDC_AUDIENCE=wger-mcp
#MCP_OIDC_ALGORITHMS=RS256
# Which claim names the user (preferred_username | email | sub).
MCP_OIDC_USERNAME_CLAIM=preferred_username
# Optional allowlist (comma-separated). Empty = any authenticated SSO user.
#MCP_OIDC_ALLOWED_USERS=
#MCP_JWKS_TTL_SECONDS=3600

# ---- Token exchange (this server as a confidential OIDC client) --------
# A confidential OIDC client with token-exchange (RFC 8693) permission to
# the wger client's audience.
OIDC_CLIENT_ID=wger-mcp
OIDC_CLIENT_SECRET=CHANGE_ME
# The audience to exchange to = wger's OIDC client id at the IdP.
WGER_OIDC_AUDIENCE=wger
# allauth provider id of the OIDC connection in wger (SocialApp.provider_id).
# Often "openid_connect", but may be a custom slug set in wger admin — match it.
WGER_ALLAUTH_PROVIDER=openid_connect

# ---- Strategy: static_token (single-user, no IdP) --------------------------
# Callers must present MCP_STATIC_TOKEN as a bearer token; the server then calls
# wger with your personal DRF API key (Settings -> API -> "API key"). Inbound
# requests ARE authenticated, so this is safe to expose over TLS — but the
# secret grants full access to that wger account, so treat it like a password.
# Generate one with:  openssl rand -hex 32      (min 32 characters)
#MCP_AUTH=static_token
#MCP_STATIC_TOKEN=
#WGER_API_KEY=

# ---- Strategy: none (LOCAL DEV ONLY) ---------------------------------------
# NO inbound authentication: anyone who can reach /mcp acts as the account
# behind WGER_API_KEY. Bind to localhost; never expose it to a network, even
# behind TLS. Prefer static_token above if you need to reach it remotely.
#MCP_AUTH=none
#WGER_API_KEY=

# --- Tool surface -----------------------------------------------------------
# Which tool groups to register, comma-separated. Empty = all of them.
# Valid groups: profile, routines_read, routines_write, workout_logs,
# workout_sessions, body_weight, measurements, equipment, nutrition,
# exercises, analytics, off. Plus "routines", meaning both routine halves.
# The full surface is 85 tools, about 18.6k tokens of schema in every request. Small local models lose accuracy as the tool
# count grows, and a single-purpose agent rarely needs every group, so trim it
# to what the agent actually uses. An unknown name fails at startup.
# Profiles (tool counts and token costs are in the README):
# a trainee following an existing plan  (28 tools, ~6.5k tokens)
#MCP_TOOLS=routines_read,workout_logs,workout_sessions,exercises
# a food-logging agent                  (29 tools, ~6.6k tokens)
#MCP_TOOLS=nutrition,off,exercises,profile
# read-only progress review             (20 tools, ~3.0k tokens)
#MCP_TOOLS=analytics,body_weight,measurements,profile

# --- Localisation -----------------------------------------------------------
# Default ISO 639-1 language for content lookups: the default for the exercise-
# and ingredient-search tools' `language` argument, and which localised Open
# Food Facts fields (product_name_<lang>, ingredients_text_<lang>) are requested
# and preferred. Per-call `language` arguments always override this.
#DEFAULT_LANGUAGE=en

# --- HTTP listener (MCP_TRANSPORT=http only) --------------------------------
HOST=0.0.0.0
PORT=8765
# MCP endpoint mount path. Final URL: http(s)://host:port/mcp
MCP_PATH=/mcp
# Externally reachable base URL. Used as the OAuth protected-resource identifier
# AND as the issuer/endpoints in the AS-facade metadata (/.well-known/
# oauth-authorization-server). REQUIRED when fronting a client like claude.ai
# that treats this origin as the authorization server. Falls back to the
# request's X-Forwarded-*/Host, then host:port.
#MCP_PUBLIC_URL=https://wger-mcp.example.com

# AS-facade endpoint paths. This origin acts as the OAuth authorization server;
# clients like claude.ai assume these conventional root paths and IGNORE the
# authorization_endpoint advertised in the AS metadata. Defaults below match that.
# Override (e.g. /oauth/authorize) only if your client expects a different path —
# no rebuild needed, these are read from the environment.
#OAUTH_AUTHORIZE_PATH=/authorize
#OAUTH_TOKEN_PATH=/token
# Dynamic client registration, proxied only when the provider offers it (wger
# publishes a registration_endpoint exactly when DCR is enabled there).
#OAUTH_REGISTER_PATH=/register

# Turn the AS facade off to advertise the provider directly instead. Only
# correct if every client you serve follows the authorization_servers pointer
# in the protected-resource metadata — claude.ai does not.
#MCP_AS_FACADE=true

# DNS rebinding protection. Comma-separated Host header values you accept.
# Empty = disabled (e.g. local dev). Production: set to your public hostname.
ALLOWED_HOSTS=
